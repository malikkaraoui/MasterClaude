{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci *)",
      "Bash(npm version *)",
      "Bash(npm view *)",
      "Bash(npm run lint*)",
      "Bash(pnpm run *)",
      "Bash(pnpm test *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(git push*)",
      "Bash(git push --tags*)",
      "Bash(git tag *)",
      "Bash(gh run *)",
      "Bash(gh pr *)",
      "Bash(ls *)",
      "Bash(cat /tmp/masterclaude*)",
      "Bash(chmod *)",
      "Bash(python scripts/switch_model.py*)",
      "Bash(python3 scripts/switch_model.py*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)"
    ]
  },
  "preferences": {
    "maxBudgetUsd": 20
  },
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "obsidian-vault": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/malik/Vault/Malik"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"hooks/session-model.sh\""
          },
          {
            "type": "command",
            "command": "bash \"hooks/vault-context.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"hooks/routing-check.sh\""
          },
          {
            "type": "command",
            "command": "bash \"hooks/model-metrics.sh\""
          },
          {
            "type": "command",
            "command": "bash \"hooks/detect-design-need.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"hooks/guard-qmd-first.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"hooks/guard-no-sign.sh\"",
            "if": "Bash(*git commit*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/guard-commit-french.sh\"",
            "if": "Bash(*git commit*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/guard-tests-before-push.sh\"",
            "if": "Bash(*git push*)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"hooks/guard-hooks-reload.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"hooks/guard-review-auto.sh\"",
            "if": "Bash(*git commit*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/telegram-notify.sh\"",
            "if": "Bash(*git commit*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/telegram-notify.sh\"",
            "if": "Bash(*git push*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/guard-anti-loop.sh\""
          },
          {
            "type": "command",
            "command": "bash \"hooks/guard-tests-before-push.sh\"",
            "if": "Bash(*npm test*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/guard-tests-before-push.sh\"",
            "if": "Bash(*jest*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/guard-tests-before-push.sh\"",
            "if": "Bash(*vitest*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/guard-tests-before-push.sh\"",
            "if": "Bash(*pytest*)"
          }
        ]
      }
    ]
  }
}
