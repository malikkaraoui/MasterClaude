{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Monitor",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskStop",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(bash *)",
      "Bash(sh *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(grep *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(stat *)",
      "Bash(find *)",
      "Bash(touch *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(mkdir *)",
      "Bash(rm *.txt)",
      "Bash(rm *.done)",
      "Bash(rm /tmp/*)",
      "Bash(rm -f /tmp/*)",
      "Bash(chmod *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(date *)",
      "Bash(pgrep *)",
      "Bash(pkill *)",
      "Bash(ps *)",
      "Bash(kill *)",
      "Bash(kill -9 *)",
      "Bash(kill -TERM *)",
      "Bash(lsof *)",
      "Bash(nohup *)",
      "Bash(curl -s *)",
      "Bash(jq *)",
      "Bash(test *)",
      "Bash(\\[ *)",
      "Bash(if *)",
      "Bash(for *)",
      "Bash(while *)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)"
    ]
  },
  "preferences": {
    "maxBudgetUsd": 20
  },
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "obsidian-vault": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/malik/Vault/Malik"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"hooks/session-model.sh\""
          },
          {
            "type": "command",
            "command": "bash \"hooks/vault-context.sh\""
          },
          {
            "type": "command",
            "command": "bash \"hooks/session-ipc-bridge.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"hooks/routing-check.sh\""
          },
          {
            "type": "command",
            "command": "bash \"hooks/model-metrics.sh\""
          },
          {
            "type": "command",
            "command": "bash \"hooks/detect-design-need.sh\""
          },
          {
            "type": "command",
            "command": "bash -c 'echo \"$(date +%s):$$:$PPID\" > /tmp/masterclaude-real-claude-active'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"hooks/guard-qmd-first.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"hooks/guard-no-sign.sh\"",
            "if": "Bash(*git commit*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/guard-commit-french.sh\"",
            "if": "Bash(*git commit*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/guard-tests-before-push.sh\"",
            "if": "Bash(*git push*)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"hooks/guard-header-check.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"hooks/guard-hooks-reload.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"hooks/guard-review-auto.sh\"",
            "if": "Bash(*git commit*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/telegram-notify.sh\"",
            "if": "Bash(*git commit*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/telegram-notify.sh\"",
            "if": "Bash(*git push*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/guard-anti-loop.sh\""
          },
          {
            "type": "command",
            "command": "bash \"hooks/guard-tests-before-push.sh\"",
            "if": "Bash(*npm test*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/guard-tests-before-push.sh\"",
            "if": "Bash(*jest*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/guard-tests-before-push.sh\"",
            "if": "Bash(*vitest*)"
          },
          {
            "type": "command",
            "command": "bash \"hooks/guard-tests-before-push.sh\"",
            "if": "Bash(*pytest*)"
          }
        ]
      }
    ]
  }
}
